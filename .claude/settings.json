{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm -s lint && pnpm -s typecheck 1>&2 || exit 2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "pnpm -s test 1>&2 && { ! command -v gitleaks >/dev/null || gitleaks protect --staged 1>&2; } || exit 2"
          }
        ]
      }
    ]
  }
}
