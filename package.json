{
  "name": "@free-commerce/repo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node scripts/brand.ts check",
    "test": "turbo run test && vitest run --root scripts",
    "knip": "knip",
    "dupes": "jscpd packages scripts --min-lines 8 --threshold 0 --ignore '**/*.test.ts'",
    "rename": "node scripts/brand.ts rename",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.6",
    "jscpd": "5.4.3",
    "knip": "6.45.1",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
