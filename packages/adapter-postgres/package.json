{
  "name": "@free-commerce/adapter-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "files": [
    "src",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --rootDir src --outDir dist --declaration",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@free-commerce/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@free-commerce/adapter-testkit": "workspace:*"
  }
}
